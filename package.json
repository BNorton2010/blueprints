{
  "name": "blueprint-library",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "wrangler dev --config wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "cloudflare:config": "node scripts/cloudflare-config.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --config wrangler.jsonc --outdir .local/dry-run",
    "content:import": "node scripts/import-content.mjs",
    "ai:check": "node scripts/check-ai.mjs",
    "cloudflare:verify": "node scripts/cloudflare-check-account.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "workerd": "1.20260926.1",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
  }
}
